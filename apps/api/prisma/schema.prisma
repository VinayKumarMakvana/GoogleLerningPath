generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================================================
// USERS & PROFILE
// ==================================================
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String // Hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?
  goals   Goal[]
}

model Profile {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @unique @db.ObjectId
  firstName  String?
  lastName   String?
  target     String? // e.g., "Google SWE", "Microsoft SWE"
  graduation DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  title      String
  type       String // e.g., "ROLE", "SKILL"
  targetDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================================================
// CURRICULUM
// ==================================================
model Track {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  topics      Topic[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Roadmap {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  phases      Phase[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Phase {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roadmapId String   @db.ObjectId
  title     String
  order     Int
  modules   Module[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

model Module {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phaseId   String   @db.ObjectId
  title     String
  order     Int
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  moduleId  String   @db.ObjectId
  title     String
  topics    Topic[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Topic {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  skillId     String  @db.ObjectId
  trackId     String? @db.ObjectId
  title       String
  description String?
  order       Int

  difficulty            String? // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  priority              String  @default("HIGH_VALUE") // "MUST_HAVE", "HIGH_VALUE", "ADVANCED", "OPTIONAL"
  estimatedLearnTime    Int     @default(60) // in minutes
  estimatedPracticeTime Int     @default(60) // in minutes
  interviewRelevance    Boolean @default(true)
  projectRelevance      Boolean @default(true)

  subtopics Subtopic[]

  // Prerequisites (MongoDB arrays for M:N self-relations)
  prerequisiteIds    String[] @db.ObjectId
  prerequisites      Topic[]  @relation("TopicPrerequisites", fields: [prerequisiteIds], references: [id])
  
  prerequisiteForIds String[] @db.ObjectId
  prerequisiteFor    Topic[]  @relation("TopicPrerequisites", fields: [prerequisiteForIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)
}

model Subtopic {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  topicId   String   @db.ObjectId
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // Relations to content
  learningContents LearningContent[]
  notes            Note[]
  shortNotes       ShortNote[]
  cheatSheets      CheatSheet[]
  resources        Resource[]
  practiceItems    PracticeItem[]
  assessments      Assessment[]
  interviewQs      InterviewQuestion[]
}

// ==================================================
// CONTENT
// ==================================================
model LearningContent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId String   @db.ObjectId
  title      String
  content    String
  type       String // "ARTICLE", "VIDEO_LINK", "INTERACTIVE"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
}

model Note {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId String   @db.ObjectId
  userId     String   @db.ObjectId // If notes are personal, could be null if global
  title      String
  content    String
  
  tagIds     String[] @db.ObjectId
  tags       Tag[]    @relation(fields: [tagIds], references: [id])
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
}

model ShortNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId String   @db.ObjectId
  title      String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
}

model CheatSheet {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId String   @db.ObjectId
  title      String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
}

model Resource {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId    String   @db.ObjectId
  title         String
  url           String
  type          String // "ARTICLE", "VIDEO", "COURSE", "TOOL"
  priority      String // "S", "A", "B"
  difficulty    String? // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  estimatedTime Int? // in minutes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
}

// ==================================================
// PRACTICE & ASSESSMENT
// ==================================================
model PracticeItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId  String   @db.ObjectId
  title       String
  description String?
  difficulty  String
  platform    String? // e.g., "LeetCode", "Codeforces"
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subtopic Subtopic          @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  attempts PracticeAttempt[]
}

model PracticeAttempt {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  practiceId String   @db.ObjectId
  userId     String   @db.ObjectId
  status     String // "SOLVED", "ATTEMPTED", "GAVE_UP"
  timeSpent  Int? // in minutes
  notes      String?
  createdAt  DateTime @default(now())

  practice PracticeItem @relation(fields: [practiceId], references: [id], onDelete: Cascade)
}

model Assessment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId String   @db.ObjectId
  title      String
  type       String // "QUIZ", "CODING", "PROJECT"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subtopic Subtopic            @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  attempts AssessmentAttempt[]
}

model AssessmentAttempt {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId String   @db.ObjectId
  userId       String   @db.ObjectId
  score        Float
  passed       Boolean
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// ==================================================
// PROJECTS
// ==================================================
model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  category    String // "FLAGSHIP", "SUPPORTING"
  difficulty  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones ProjectMilestone[]
}

model ProjectMilestone {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==================================================
// INTERVIEW PREPARATION
// ==================================================
model InterviewQuestion {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  subtopicId String   @db.ObjectId
  question   String
  answerHint String?
  type       String // "TECHNICAL", "BEHAVIORAL", "SYSTEM_DESIGN"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime
  type      String // "MOCK", "REAL"
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================================================
// PROGRESS & PLANNING
// ==================================================
model Progress {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   // Intentionally left as String for generic ID tracking
  entityId   String   // Intentionally left as String since it could point to multiple models
  entityType String // "TOPIC", "SUBTOPIC"
  status     String // "NOT_STARTED", "IN_PROGRESS", "COMPLETED"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RevisionSchedule {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  nextRevision DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items RevisionItem[]
}

model RevisionItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  scheduleId String   @db.ObjectId
  entityId   String   @db.ObjectId // E.g. SubtopicId
  entityType String // E.g. "SUBTOPIC"
  interval   Int // Spaced repetition interval in days
  easeFactor Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule RevisionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model DailyPlan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================================================
// METADATA
// ==================================================
model Tag {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String   @unique
  
  noteIds String[] @db.ObjectId
  notes   Note[]   @relation(fields: [noteIds], references: [id])
}

model Bookmark {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  entityId   String   @db.ObjectId
  entityType String
  createdAt  DateTime @default(now())
}
