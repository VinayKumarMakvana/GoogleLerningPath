# ==================================================
# PLATFORM ENVIRONMENT VARIABLES (EXAMPLE)
# ==================================================

# --------------------------------------------------
# BACKEND API (apps/api)
# --------------------------------------------------
# Port the Express server will listen on
PORT=4000

# MongoDB database connection string (used by Prisma)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mentorship-platform?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://admin:password123@cluster0.abcde.mongodb.net/mentorship-platform?retryWrites=true&w=majority"
# JWT Secret for authentication tokens
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# --------------------------------------------------
# FRONTEND APP (apps/web)
# --------------------------------------------------
# Base URL for the frontend application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL pointing to the API (used for client-side fetches)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
